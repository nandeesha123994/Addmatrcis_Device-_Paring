# Port for Vendor and Device Pairing API
PORT=5001

# Port for Android TV mTLS API
TV_PORT=5002

# PostgreSQL database connection
DATABASE_URL="postgresql://postgres:admin@localhost:5432/device_pairing_db"

# Redis connection for temporary pairing sessions and codes
REDIS_URL="redis://localhost:6379"

# Secret key used to create and verify pairing-code HMACs
PAIRING_SECRET=49fdcd7b3f923173c16ede0d5a22c23b8ae586373b68080224acaef0b79369aa


# JWT Authentication - Admetrics

# Location of the public key used to verify JWT tokens
JWT_PUBLIC_KEY_PATH=".keys/jwt-public.pem"

# Expected JWT issuer
JWT_ISSUER="admetrics"

# Expected JWT audience
JWT_AUDIENCE="admetrics-api"

# Access token validity: 900 seconds (15 minutes)
ACCESS_TOKEN_SECONDS="900"

# Admetrics backend API URL
ADMETRICS_API_URL="http://localhost:3000"

# AWS region where Private CA will be configured
AWS_REGION=your-aws-region

# ARN identifying the AWS Private Certificate Authority
AWS_PRIVATE_CA_ARN=your-private-ca-arn